# Jangan tampilkan daftar isi folder
Options -Indexes

# Lindungi file konfigurasi & sistem dari akses langsung
<FilesMatch "^(config\.php|bootstrap\.php|auth_style\.php|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Lindungi berkas pendukung yang tidak perlu dibuka publik
# (log server lokal, database, catatan pemasangan, skrip .bat)
<FilesMatch "\.(log|db|sqlite|sqlite3|md|bat|ini|bak|sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Cadangan: blokir folder data/ dan uploads/ dari sini juga, kalau-kalau
  # .htaccess di dalam folder itu ikut terhapus saat menyalin file.
  RewriteRule ^(data|uploads)/ - [F,L]

  # ===== URL rapi: sembunyikan ".php" di address bar =====
  # 1) Bila pengunjung membuka .../namahalaman.php, alihkan ke .../namahalaman
  #    (query string ikut terbawa). Endpoint di bawah DIKECUALIKAN supaya
  #    pemanggilan JS/unduhan tetap jalan.
  RewriteCond %{THE_REQUEST} \s/+([^./\s?]+)\.php[\s?] [NC]
  RewriteCond %1 !^(api|download|zip|google_login|config|bootstrap|auth_style|router)$ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) Sajikan file .php-nya secara diam-diam untuk URL tanpa .php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# (Mematikan mesin PHP HANYA dilakukan di uploads/.htaccess, TIDAK di sini —
#  kalau ditaruh di root, seluruh situs ikut mati.)

# Header keamanan dasar
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Halaman default
DirectoryIndex index.php
